# --- Telegram ---
# Create a bot with @BotFather on Telegram, it will give you this token.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# --- Admin API ---
# Generate a long random value, e.g. `openssl rand -hex 32`.
API_SECRET_KEY="replace-with-a-long-random-secret"
PORT=3000

# --- Thaler API ---
THALER_API_BASE_URL=https://thalerapi.example.com
THALER_API_KEY=tlr_live_replace-with-real-key
# Wallet address to poll for vault updates.
THALER_WALLET_ADDRESS=replace-with-solana-wallet-address
# How often to poll for lifecycle changes, in ms. Defaults to 300000 (5 minutes).
THALER_POLL_INTERVAL_MS=300000
# How often to push the aggregate portfolio summary, in ms. Defaults to 3600000 (1 hour).
THALER_PORTFOLIO_INTERVAL_MS=3600000

# --- Storage ---
DB_PATH=./data/users.db

# --- Logging ---
LOG_LEVEL=info
